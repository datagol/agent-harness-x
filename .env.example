# Copy to .env at the repository root. The examples and harness-web load it;
# a standalone application must load it itself. Never commit .env.

# Default provider
ANTHROPIC_API_KEY=

# Other providers (each needs its extra: uv add "harnessx[openai]" etc.)
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_VERSION=

# Choose the model for examples that honor it (skills_interactive, knowledge_bundles_okf)
AGENT_PROVIDER=anthropic
AGENT_MODEL=claude-sonnet-4-6

# Tracing and evaluations (langsmith extra)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=harnessx-demo

# Live Jev decisions (jev extra)
TYPESAFE_API_KEY=

# PostgreSQL runtime example (postgres extra)
DATABASE_URL=

# Service-backed tests; unset means they skip
HARNESS_TEST_POSTGRES_DSN=
HARNESS_TEST_REDIS=
HARNESS_TEST_TEMPORAL=
